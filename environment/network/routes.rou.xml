<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89"/>
    <route id="n_s" edges="north_in south_out"/>
    <route id="n_e" edges="north_in east_out"/>
    <route id="n_w" edges="north_in west_out"/>
    <route id="s_n" edges="south_in north_out"/>
    <route id="s_e" edges="south_in east_out"/>
    <route id="s_w" edges="south_in west_out"/>
    <route id="e_w" edges="east_in west_out"/>
    <route id="e_n" edges="east_in north_out"/>
    <route id="e_s" edges="east_in south_out"/>
    <route id="w_e" edges="west_in east_out"/>
    <route id="w_n" edges="west_in north_out"/>
    <route id="w_s" edges="west_in south_out"/>

    <!-- 每个入口随机选方向：直行 60%，左转 20%，右转 20%。 -->
    <routeDistribution id="north_choices" routes="n_s n_e n_w" probabilities="0.6 0.2 0.2"/>
    <routeDistribution id="south_choices" routes="s_n s_w s_e" probabilities="0.6 0.2 0.2"/>
    <routeDistribution id="east_choices" routes="e_w e_s e_n" probabilities="0.6 0.2 0.2"/>
    <routeDistribution id="west_choices" routes="w_e w_n w_s" probabilities="0.6 0.2 0.2"/>

    <!-- 每秒独立生成概率约为原有每小时总流量除以 3600。 -->
    <flow id="north" type="car" route="north_choices" begin="0" end="900" probability="0.1944444444" departLane="best" departSpeed="max"/>
    <flow id="south" type="car" route="south_choices" begin="0" end="900" probability="0.1944444444" departLane="best" departSpeed="max"/>
    <flow id="east" type="car" route="east_choices" begin="0" end="900" probability="0.1416666667" departLane="best" departSpeed="max"/>
    <flow id="west" type="car" route="west_choices" begin="0" end="900" probability="0.1416666667" departLane="best" departSpeed="max"/>
</routes>
